diff --git a/src/components/hero/AmbientScene.tsx b/src/components/hero/AmbientScene.tsx
new file mode 100644
index 0000000..63d76a0
--- /dev/null
+++ b/src/components/hero/AmbientScene.tsx
@@ -0,0 +1,68 @@
+import { useMemo, useRef } from "react";
+import { Canvas, useFrame } from "@react-three/fiber";
+import { Float } from "@react-three/drei";
+import { CanvasTexture, type Points } from "three";
+
+function Particles({ count = 110 }: { count?: number }) {
+  const ref = useRef<Points>(null);
+  const positions = useMemo(() => {
+    const a = new Float32Array(count * 3);
+    for (let i = 0; i < count; i++) {
+      a[i * 3] = (Math.random() - 0.5) * 12;
+      a[i * 3 + 1] = (Math.random() - 0.5) * 5;
+      a[i * 3 + 2] = (Math.random() - 0.5) * 4;
+    }
+    return a;
+  }, [count]);
+  const dot = useMemo(() => {
+    const c = document.createElement("canvas");
+    c.width = c.height = 32;
+    const g = c.getContext("2d");
+    if (g) { g.beginPath(); g.arc(16, 16, 14, 0, Math.PI * 2); g.fillStyle = "#fff"; g.fill(); }
+    return new CanvasTexture(c);
+  }, []);
+  useFrame((state, dt) => {
+    if (!ref.current) return;
+    ref.current.rotation.y += dt * 0.03;
+    ref.current.rotation.x = Math.sin(state.clock.elapsedTime * 0.2) * 0.08;
+  });
+  return (
+    <points ref={ref}>
+      <bufferGeometry>
+        <bufferAttribute attach="attributes-position" count={count} array={positions} itemSize={3} />
+      </bufferGeometry>
+      <pointsMaterial size={0.09} map={dot} alphaTest={0.3} color="#8b7cf6" transparent opacity={0.7} sizeAttenuation depthWrite={false} />
+    </points>
+  );
+}
+
+function Orb({ position, color, size }: { position: [number, number, number]; color: string; size: number }) {
+  return (
+    <Float speed={1.1} rotationIntensity={0.5} floatIntensity={1.4}>
+      <mesh position={position}>
+        <icosahedronGeometry args={[size, 1]} />
+        <meshStandardMaterial color={color} transparent opacity={0.55} roughness={0.35} flatShading />
+      </mesh>
+    </Float>
+  );
+}
+
+/** Soft floating field. No models, no post-processing, capped pixel ratio, pauses when `active` is false. */
+export default function AmbientScene({ active }: { active: boolean }) {
+  return (
+    <Canvas
+      dpr={[1, 1.5]}
+      frameloop={active ? "always" : "never"}
+      camera={{ position: [0, 0, 6], fov: 50 }}
+      gl={{ antialias: false, alpha: true, powerPreference: "low-power" }}
+      style={{ background: "transparent" }}
+    >
+      <ambientLight intensity={0.9} />
+      <directionalLight position={[3, 4, 5]} intensity={0.8} />
+      <Particles />
+      <Orb position={[-3.4, 0.6, 0]} color="#f06a6a" size={0.55} />
+      <Orb position={[3.2, -0.4, -0.5]} color="#8b7cf6" size={0.7} />
+      <Orb position={[0.6, 1.3, -1]} color="#7cc4f6" size={0.35} />
+    </Canvas>
+  );
+}
diff --git a/src/components/hero/HeroAmbient.tsx b/src/components/hero/HeroAmbient.tsx
new file mode 100644
index 0000000..a4f10c4
--- /dev/null
+++ b/src/components/hero/HeroAmbient.tsx
@@ -0,0 +1,59 @@
+import { Component, lazy, Suspense, useEffect, useRef, useState, type ReactNode } from "react";
+import { cn } from "@/lib/utils";
+
+const AmbientScene = lazy(() => import("./AmbientScene"));
+
+class Quiet extends Component<{ children: ReactNode }, { failed: boolean }> {
+  state = { failed: false };
+  static getDerivedStateFromError() { return { failed: true }; }
+  componentDidCatch(error: Error) { console.info("Ambient scene disabled:", error.message); }
+  render() { return this.state.failed ? null : this.props.children; }
+}
+
+function webglAvailable() {
+  try {
+    const canvas = document.createElement("canvas");
+    return Boolean(canvas.getContext("webgl2") || canvas.getContext("webgl"));
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Decorative 3D layer. Renders nothing (the CSS gradient behind it remains) when WebGL is
+ * missing, motion is reduced, or the scene fails. Pauses when hidden or scrolled offscreen.
+ */
+export function HeroAmbient({ className }: { className?: string }) {
+  const box = useRef<HTMLDivElement>(null);
+  const [enabled, setEnabled] = useState(false);
+  const [visible, setVisible] = useState(true);
+  const [tabVisible, setTabVisible] = useState(true);
+
+  useEffect(() => {
+    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
+    const update = () => setEnabled(!reduced.matches && webglAvailable());
+    update();
+    reduced.addEventListener("change", update);
+    return () => reduced.removeEventListener("change", update);
+  }, []);
+
+  useEffect(() => {
+    const el = box.current;
+    if (!el || typeof IntersectionObserver === "undefined") return;
+    const io = new IntersectionObserver(([entry]) => setVisible(entry.isIntersecting));
+    io.observe(el);
+    const onVis = () => setTabVisible(!document.hidden);
+    document.addEventListener("visibilitychange", onVis);
+    return () => { io.disconnect(); document.removeEventListener("visibilitychange", onVis); };
+  }, []);
+
+  return (
+    <div ref={box} aria-hidden className={cn("pointer-events-none", className)}>
+      {enabled && (
+        <Quiet>
+          <Suspense fallback={null}><AmbientScene active={visible && tabVisible} /></Suspense>
+        </Quiet>
+      )}
+    </div>
+  );
+}
