+import { X } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent } from "@/components/ui/card";
+import { Skeleton } from "@/components/ui/skeleton";
+import { JobDetailsHeader } from "@/components/job-details/JobDetailsHeader";
+import { JobDetailsForm } from "@/components/job-details/JobDetailsForm";
+import { JobDetailsActions } from "@/components/job-details/JobDetailsActions";
+import { InvoiceNumberSection } from "@/components/job-details/InvoiceNumberSection";
+import { useJobDetails } from "@/hooks/useJobDetails";
+import type { Job } from "@/pages/Index";
+
+interface Props { job: Job | null; loading: boolean; isEditMode?: boolean; onClose: () => void }
+
+/** Inline version of the job dialog, shown inside a job tab. Same hook, same sections, same writes. */
+export function JobDetailsPanel({ job, loading, isEditMode = false, onClose }: Props) {
+  const d = useJobDetails({ job, isEditMode, onClose });
+
+  if (!job) {
+    return (
+      <div className="mx-auto w-full max-w-4xl p-3 md:p-6">
+        <Card>
+          <CardContent className="space-y-4 p-6">
+            {loading ? (
+              <><Skeleton className="h-8 w-2/3" /><Skeleton className="h-32 w-full" /><Skeleton className="h-24 w-full" /></>
+            ) : (
+              <>
+                <h2 className="text-h2">This job isn’t available</h2>
+                <p className="text-sm text-muted-foreground">It may have been deleted, or it hasn’t synced to this device yet. Close this tab and open the job again from the dashboard.</p>
+                <Button onClick={onClose}>Close tab</Button>
+              </>
+            )}
+          </CardContent>
+        </Card>
+      </div>
+    );
+  }
+
+  return (
+    <div className="mx-auto w-full max-w-4xl space-y-3 p-3 md:p-6">
+      <div className="flex justify-end">
+        <Button type="button" variant="outline" size="sm" onClick={onClose}><X className="h-4 w-4" />Close tab</Button>
+      </div>
+      <Card>
+        <CardContent className="space-y-6 p-4 md:p-6">
+          <JobDetailsHeader job={job} isEditMode={isEditMode} isExporting={d.isExporting} isSharing={d.isSharing} onExportPDF={d.handleExportPDF} onShareWhatsApp={d.handleShareWhatsApp} />
+          <InvoiceNumberSection invoiceNumber={d.invoiceNumber} onInvoiceNumberChange={d.setInvoiceNumber} canEditInvoice={d.canEditInvoice} />
+          <JobDetailsForm job={job} isEditMode={isEditMode} editData={d.editData} onEditDataChange={d.setEditData} />
+          <JobDetailsActions isEditMode={isEditMode} isLoading={d.isLoading} onClose={onClose} onSave={d.handleSave} />
+        </CardContent>
+      </Card>
+    </div>
+  );
+}
diff --git a/src/components/shell/TabStrip.tsx b/src/components/shell/TabStrip.tsx
new file mode 100644
index 0000000..d116631
--- /dev/null
+++ b/src/components/shell/TabStrip.tsx
@@ -0,0 +1,215 @@
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import { DndContext, KeyboardSensor, PointerSensor, closestCenter, useSensor, useSensors, type DragEndEvent } from "@dnd-kit/core";
+import { SortableContext, horizontalListSortingStrategy, sortableKeyboardCoordinates, useSortable } from "@dnd-kit/sortable";
+import { CSS } from "@dnd-kit/utilities";
+import { FileText, LayoutGrid, Pin, Plus, X } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { ContextMenu, ContextMenuContent, ContextMenuItem, ContextMenuSeparator, ContextMenuTrigger } from "@/components/ui/context-menu";
+import { Sheet, SheetContent, SheetHeader, SheetTitle } from "@/components/ui/sheet";
+import { cn } from "@/lib/utils";
+import { gsap, useMotionOK } from "@/lib/motion";
+import type { AppTab } from "@/hooks/useTabs";
+import { NAV_ITEMS } from "./navItems";
+
+interface Props {
+  tabs: AppTab[];
+  activeId: string;
+  onActivate: (tab: AppTab) => void;
+  onClose: (id: string) => void;
+  onCloseOthers: (id: string) => void;
+  onTogglePin: (id: string) => void;
+  onReorder: (fromId: string, toId: string) => void;
+  onNew: () => void;
+}
+
+const tabIcon = (tab: AppTab) => (tab.kind === "job" ? FileText : NAV_ITEMS.find((n) => n.id === tab.view)?.icon ?? FileText);
+
+interface SortableTabProps {
+  tab: AppTab;
+  active: boolean;
+  tabIndex: number;
+  register: (id: string, el: HTMLElement | null) => void;
+  onActivate: (tab: AppTab) => void;
+  onClose: (id: string) => void;
+  onCloseOthers: (id: string) => void;
+  onTogglePin: (id: string) => void;
+  onlyTab: boolean;
+}
+
+function SortableTab({ tab, active, tabIndex, register, onActivate, onClose, onCloseOthers, onTogglePin, onlyTab }: SortableTabProps) {
+  const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({ id: tab.id });
+  const Icon = tabIcon(tab);
+  return (
+    <ContextMenu>
+      <ContextMenuTrigger asChild>
+        <div
+          ref={(el) => { setNodeRef(el); register(tab.id, el); }}
+          role="presentation"
+          style={{ transform: CSS.Transform.toString(transform ? { ...transform, y: 0, scaleX: 1, scaleY: 1 } : null), transition }}
+          className={cn(
+            "group relative flex shrink-0 animate-tab-in items-center rounded-xl border border-transparent text-sm transition-[background-color,box-shadow,color] duration-150",
+            active
+              ? "bg-card text-foreground shadow-[0_0_0_1px_hsl(var(--brand)/0.30),0_8px_18px_-8px_hsl(var(--brand)/0.5)]"
+              : "text-muted-foreground hover:bg-card/60 hover:text-foreground",
+            isDragging && "z-10 opacity-90 shadow-lg",
+          )}
+        >
+          <button
+            type="button"
+            {...attributes}
+            {...listeners}
+            role="tab"
+            aria-selected={active}
+            tabIndex={tabIndex}
+            data-tab-id={tab.id}
+            title={tab.title}
+            onClick={() => onActivate(tab)}
+            aria-keyshortcuts="Delete"
+            onKeyDown={(e) => { if (e.key === "Delete") { e.preventDefault(); onClose(tab.id); } }}
+            onAuxClick={(e) => { if (e.button === 1) { e.preventDefault(); onClose(tab.id); } }}
+            className={cn("flex h-9 min-w-0 items-center gap-2 rounded-xl ps-3 outline-none focus-visible:ring-2 focus-visible:ring-ring", tab.pinned ? "pe-3" : "pe-1", tab.pinned ? "w-11 justify-center ps-0 pe-0" : "max-w-[11rem]")}
+          >
+            <Icon className="h-4 w-4 shrink-0" aria-hidden />
+            {!tab.pinned && <span className="truncate font-medium">{tab.title}</span>}
+            {tab.pinned && <Pin className="absolute end-1 top-1 h-2.5 w-2.5 text-brand" aria-hidden />}
+          </button>
+          {!tab.pinned && (
+            <button
+              type="button"
+              aria-hidden="true"
+              tabIndex={-1}
+              onClick={() => onClose(tab.id)}
+              className="me-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-muted-foreground opacity-70 hover:bg-muted hover:text-foreground hover:opacity-100 focus-visible:opacity-100 group-hover:opacity-100"
+            >
+              <X className="h-3.5 w-3.5" aria-hidden />
+            </button>
+          )}
+        </div>
+      </ContextMenuTrigger>
+      <ContextMenuContent>
+        <ContextMenuItem onSelect={() => onTogglePin(tab.id)}>{tab.pinned ? "Unpin tab" : "Pin tab"}</ContextMenuItem>
+        <ContextMenuItem onSelect={() => onClose(tab.id)}>Close tab</ContextMenuItem>
+        <ContextMenuSeparator />
+        <ContextMenuItem disabled={onlyTab} onSelect={() => onCloseOthers(tab.id)}>Close other tabs</ContextMenuItem>
+      </ContextMenuContent>
+    </ContextMenu>
+  );
+}
+
+export function TabStrip({ tabs, activeId, onActivate, onClose, onCloseOthers, onTogglePin, onReorder, onNew }: Props) {
+  const listRef = useRef<HTMLDivElement>(null);
+  const barRef = useRef<HTMLDivElement>(null);
+  const els = useRef(new Map<string, HTMLElement>());
+  const motionOK = useMotionOK();
+  const [switcherOpen, setSwitcherOpen] = useState(false);
+
+  const sensors = useSensors(
+    useSensor(PointerSensor, { activationConstraint: { distance: 6 } }),
+    useSensor(KeyboardSensor, { coordinateGetter: sortableKeyboardCoordinates }),
+  );
+
+  const register = (id: string, el: HTMLElement | null) => { if (el) els.current.set(id, el); else els.current.delete(id); };
+
+  // Sliding indicator under the active tab.
+  useLayoutEffect(() => {
+    const el = els.current.get(activeId);
+    const bar = barRef.current;
+    if (!el || !bar) return;
+    const vars = { x: el.offsetLeft, width: el.offsetWidth };
+    if (motionOK.current) gsap.to(bar, { ...vars, duration: 0.38, ease: "back.out(1.5)", overwrite: true });
+    else gsap.set(bar, vars);
+    el.scrollIntoView?.({ block: "nearest", inline: "nearest" });
+  }, [activeId, tabs, motionOK]);
+
+  useEffect(() => {
+    const list = listRef.current;
+    if (!list || typeof ResizeObserver === "undefined") return;
+    const ro = new ResizeObserver(() => {
+      const el = els.current.get(activeId);
+      if (el && barRef.current) gsap.set(barRef.current, { x: el.offsetLeft, width: el.offsetWidth });
+    });
+    ro.observe(list);
+    return () => ro.disconnect();
+  }, [activeId]);
+
+  const onDragEnd = ({ active, over }: DragEndEvent) => { if (over && active.id !== over.id) onReorder(String(active.id), String(over.id)); };
+
+  const onKeyDown = (e: React.KeyboardEvent) => {
+    const rtl = getComputedStyle(e.currentTarget).direction === "rtl";
+    const index = tabs.findIndex((t) => t.id === activeId);
+    let next = -1;
+    if (e.key === "ArrowRight") next = index + (rtl ? -1 : 1);
+    else if (e.key === "ArrowLeft") next = index + (rtl ? 1 : -1);
+    else if (e.key === "Home") next = 0;
+    else if (e.key === "End") next = tabs.length - 1;
+    if (next < 0 || next >= tabs.length) return;
+    e.preventDefault();
+    onActivate(tabs[next]);
+    requestAnimationFrame(() => els.current.get(tabs[next].id)?.querySelector<HTMLElement>('[role="tab"]')?.focus());
+  };
+
+  return (
+    <div className="glass flex shrink-0 items-center gap-1 border-x-0 border-t-0 px-2 py-1.5 shadow-none">
+      <div className="relative min-w-0 flex-1">
+        <DndContext sensors={sensors} collisionDetection={closestCenter} onDragEnd={onDragEnd}>
+          <SortableContext items={tabs.map((t) => t.id)} strategy={horizontalListSortingStrategy}>
+            <div
+              ref={listRef}
+              role="tablist"
+              aria-label="Open tabs"
+              onKeyDown={onKeyDown}
+              className="relative flex items-center gap-1 overflow-x-auto pb-1.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
+            >
+              {tabs.map((tab) => (
+                <SortableTab
+                  key={tab.id}
+                  tab={tab}
+                  active={tab.id === activeId}
+                  tabIndex={tab.id === activeId ? 0 : -1}
+                  register={register}
+                  onActivate={onActivate}
+                  onClose={onClose}
+                  onCloseOthers={onCloseOthers}
+                  onTogglePin={onTogglePin}
+                  onlyTab={tabs.length < 2}
+                />
+              ))}
+              <div ref={barRef} aria-hidden className="pointer-events-none absolute bottom-0 start-0 h-0.5 rounded-full bg-primary" style={{ width: 0 }} />
+            </div>
+          </SortableContext>
+        </DndContext>
+      </div>
+      <Button type="button" variant="ghost" size="icon" className="h-9 w-9 shrink-0 rounded-xl" aria-label="New tab (Ctrl+T or Alt+T)" onClick={onNew}>
+        <Plus className="h-4 w-4" />
+      </Button>
+      <Button type="button" variant="ghost" size="icon" className="relative h-9 w-9 shrink-0 rounded-xl md:hidden" aria-label={`Switch tabs, ${tabs.length} open`} onClick={() => setSwitcherOpen(true)}>
+        <LayoutGrid className="h-4 w-4" />
+        <span className="absolute -end-0.5 -top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-primary px-1 text-[10px] font-semibold text-primary-foreground">{tabs.length}</span>
+      </Button>
+
+      <Sheet open={switcherOpen} onOpenChange={setSwitcherOpen}>
+        <SheetContent side="bottom" className="max-h-[80dvh] overflow-y-auto rounded-t-3xl">
+          <SheetHeader><SheetTitle>Open tabs</SheetTitle></SheetHeader>
+          <ul className="mt-4 space-y-2">
+            {tabs.map((tab) => {
+              const Icon = tabIcon(tab);
+              return (
+                <li key={tab.id} className={cn("flex items-center gap-2 rounded-2xl border p-1", tab.id === activeId ? "border-primary/40 bg-primary/5" : "border-border")}>
+                  <button type="button" className="flex min-h-11 flex-1 items-center gap-3 rounded-xl px-3 text-start" onClick={() => { onActivate(tab); setSwitcherOpen(false); }}>
+                    <Icon className="h-4 w-4 shrink-0" aria-hidden />
+                    <span className="truncate font-medium">{tab.title}</span>
+                    {tab.pinned && <Pin className="h-3 w-3 text-brand" aria-label="Pinned" />}
+                  </button>
+                  <Button type="button" variant="ghost" size="icon" className="h-11 w-11" aria-label={`Close ${tab.title}`} onClick={() => onClose(tab.id)}><X className="h-4 w-4" /></Button>
+                </li>
+              );
+            })}
+          </ul>
+          {tabs.length > 1 && (
+            <Button type="button" variant="outline" className="mt-4 w-full" onClick={() => { onCloseOthers(activeId); setSwitcherOpen(false); }}>Close other tabs</Button>
+          )}
+        </SheetContent>
+      </Sheet>
+    </div>
+  );
+}
